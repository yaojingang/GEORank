FROM mcr.microsoft.com/playwright/python:v1.64.1-jammy@sha256:d64f6b212d8ebb4ae25bfaeef820351bf79e562aa5d3c754b072ec16168de010

WORKDIR /app

# 额外系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && \
    rm -rf /var/lib/apt/lists/*

# Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --chmod=0755 docker-entrypoint.sh /usr/local/bin/georank-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/georank-entrypoint

ENTRYPOINT ["/usr/local/bin/georank-entrypoint"]
CMD ["celery", "-A", "app.core.celery_app", "worker", "-l", "info", "-c", "2", "-Q", "crawl"]
