FROM mcr.microsoft.com/playwright/python:v1.62.0-jammy@sha256:017530b316b85f71b3f0989310393a9095253820e77e9ed94aa3b7d7eb5ecd16

WORKDIR /app

# 额外系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && \
    rm -rf /var/lib/apt/lists/*

# Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --chmod=0755 docker-entrypoint.sh /usr/local/bin/georank-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/georank-entrypoint

ENTRYPOINT ["/usr/local/bin/georank-entrypoint"]
CMD ["celery", "-A", "app.core.celery_app", "worker", "-l", "info", "-c", "2", "-Q", "crawl"]
